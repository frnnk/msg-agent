# Copy this file to .env and fill in your values: cp .env.example .env

# LLM provider keys (set at least one matching the model strings below)
OPENAI_API_KEY=sk-your-openai-key
GOOGLE_API_KEY=your-google-api-key

# Optional: override the default models (format "provider:model")
# TASK_EXECUTOR_MODEL=openai:gpt-5-nano
# POLICY_ROUTER_MODEL=openai:gpt-5-nano

# MCP server that exposes the agent's tools
EXAMPLE_MCP_URL=http://localhost:8000/mcp

# Optional: Langfuse observability (leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Test REPL client only (tests/client.py)
SERVER_DOMAIN=localhost:8002
